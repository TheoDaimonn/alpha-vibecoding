__pycache__/
.pytest_cache/
.ipynb_checkpoints/
.venv/
.env
*.crt
.kaggle/
*.egg-info/
/data
# Training checkpoints (17GB) — not committed.
ru_gliner_hybrid_v4/artifacts/

# Distilled student checkpoint IS committed (small, ~800KB).
!artifacts/student-pii.pt
artifacts/*
!artifacts/student-pii.pt

# Datasets (JSONL corpora) — regenerated by scripts/make_corpus.sh, too large for git.
# README.md / .gitkeep inside these dirs are still tracked.
ru_gliner_hybrid_v4/data/hybrid/*.jsonl
ru_gliner_hybrid_v4/data/hybrid/audit.json
ru_gliner_hybrid_v4/data/hybrid/manifest.json
ru_gliner_hybrid_v4/data/real/*.jsonl
ru_gliner_hybrid_v4/data/real/audit.json
ru_gliner_hybrid_v4/data/real/manifest.json
ru_gliner_hybrid_v4/data/supplement/*.jsonl
ru_gliner_hybrid_v4/data/supplement/audit.json
ru_gliner_hybrid_v4/data/supplement/manifest.json
ru_gliner_hybrid_v4/data/redmadrobot/*.jsonl
ru_gliner_hybrid_v4/data/redmadrobot/manifest.json

# Large/binary files that exceed GitHub's 100MB limit.
*.safetensors
*.bin
*.onnx
*.h5
*.pkl
*.npz
*.tar
*.tar.gz
*.tgz
*.zip
*.pt
*.pth
*.ckpt
*.pdf

# Keep the small committed student checkpoint despite the *.pt rule above.
!artifacts/student-pii.pt

# Model weights in models/ ARE committed via Git LFS (see .gitattributes).
!ru_gliner_hybrid_v4/models/**/*.safetensors