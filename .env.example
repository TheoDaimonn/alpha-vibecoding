# Copy to .env; Compose reads it automatically. Direct Python runs need exported env.
DETECTOR=rubert_onnx
API_PORT=8000
API_WORKERS=2
API_CPUS=6
API_MEMORY_LIMIT=4g
API_KEYS=
RUBERT_MODEL_PATH=/app/artifacts/rubert-tiny2-fine-tuning
# Blank = use model_config.json (currently window 1024, stride 128).
RUBERT_MAX_LEN=
RUBERT_STRIDE=
MODEL_BATCH_SIZE=8
ONNX_INTRA_THREADS=1
ONNX_INTER_THREADS=1
WORKER_QUEUE_SIZE=256
WORKER_QUEUE_CHARS=4000000
WORKER_THREADS=2
WORKER_BATCH_SIZE=32
WORKER_BATCH_TIMEOUT_S=0.005
REQUEST_TIMEOUT_S=9
RESULT_TTL_S=3600
CORRELATION_STORE=redis
REDIS_URL=redis://redis:6379/0
POSTPROCESS=0
DEVICE=cpu
THRESHOLD=0.5
STUDENT_MODEL_PATH=/app/artifacts/student-pii.pt
TUNNEL_TARGET=api:8000
